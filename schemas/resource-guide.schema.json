{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seller-transition-exchange.feimster.chatgpt.site/schemas/resource-guide.schema.json",
  "title": "Seller Transition Exchange resource guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "description",
    "category",
    "seller_stage",
    "audience",
    "transition_paths",
    "estimated_read_time",
    "display_order",
    "featured",
    "evidence_status",
    "last_reviewed",
    "related_modules",
    "related_guides",
    "primary_cta",
    "primary_cta_href",
    "secondary_cta",
    "secondary_cta_href"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 8 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 60, "maxLength": 190 },
    "category": {
      "enum": [
        "Sale Preparation",
        "Valuation and Value Building",
        "Financial Readiness",
        "Financing",
        "Ownership Transition",
        "Confidentiality",
        "Advisors",
        "Transition Execution"
      ]
    },
    "seller_stage": {
      "enum": ["Explore", "Prepare", "Package", "Match", "Transition", "Post-Close"]
    },
    "audience": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "transition_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "estimated_read_time": { "type": "string", "pattern": "^\\d+ min read$" },
    "display_order": { "type": "integer", "minimum": 1, "maximum": 14 },
    "featured": { "type": "boolean" },
    "evidence_status": { "const": "editorial-review-required" },
    "last_reviewed": { "type": "string", "format": "date" },
    "related_modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "related_guides": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "primary_cta": { "type": "string", "minLength": 5 },
    "primary_cta_href": { "type": "string", "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" },
    "secondary_cta": { "type": "string", "minLength": 5 },
    "secondary_cta_href": { "type": "string", "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" }
  }
}
